<group name="soc_lab,authentication_failed,">
  <rule id="100100" level="10" frequency="5" timeframe="60">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>SOC-LAB: Repeated Windows failed login attempts detected</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,soc_lab,</group>
  </rule>
</group>

